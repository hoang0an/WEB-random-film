{
  "name": "toi-nay-xem-gi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test-isolation=none --experimental-strip-types --test tests/domain.test.ts tests/movie-wheel.test.ts tests/movie-filters.test.ts tests/auth.test.ts tests/auth-service.test.ts tests/auth-redirect.test.ts tests/group-permissions.test.ts tests/repository-errors.test.ts",
    "test:db": "node tests/database.mjs && node tests/group-management-db.mjs",
    "test:api": "node tests/api.mjs",
    "test:e2e": "python -X utf8 tests/e2e.py",
    "test:wheel": "python -X utf8 tests/movie_wheel_e2e.py",
    "test:polish": "python -X utf8 tests/draw_polish_e2e.py",
    "test:acceptance": "python -X utf8 tests/acceptance_e2e.py",
    "test:live-errors": "python -X utf8 tests/live_failure_e2e.py",
    "test:auth:e2e": "python -X utf8 tests/auth_e2e.py",
    "test:auth:sessions": "python -X utf8 tests/auth_sessions_e2e.py",
    "test:auth:google": "python -X utf8 tests/auth_google_e2e.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
