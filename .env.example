# Để trống cả ba biến để chạy bản dùng thử (localStorage, không đồng bộ thiết bị).
# Sao chép thành .env.local; không commit file chứa giá trị thật.
# Vercel: đặt giá trị trong Project Settings > Environment Variables rồi Redeploy.
# Supabase: Project URL và publishable/anon key công khai; RLS bảo vệ dữ liệu.
# Không dùng service_role/secret key, mật khẩu database hay Google Client Secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Để false khi chỉ dùng email; đổi true sau khi bật Google provider rồi rebuild.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# TMDB: API Read Access Token (Bearer), chỉ máy chủ được đọc. Không thêm NEXT_PUBLIC_.
TMDB_READ_ACCESS_TOKEN=
# CINEMA_QA_BUILD chỉ dùng trong kiểm thử giả lập, không cấu hình trên hosting.
